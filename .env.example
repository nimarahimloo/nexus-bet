# Nexus Bet — copy to .env and fill values. Never commit real secrets.

NODE_ENV=development
PORT=3000

# Required for production boot
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=mysql://user:pass@host:3306/nexus_bet

# Public URL of this deployment (no trailing slash). Required for payment IPN callbacks.
APP_PUBLIC_URL=https://your-domain.example

# Optional platform / OAuth (only required when external OAuth is enabled)
# Browser login portal and server-side OAuth API must be configured together.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Sports feed (API-Football or compatible). Without this, UI stays in labeled fallback.
SPORTS_API_KEY=

# NOWPayments USDT BEP20. All three required to enable deposits; payout token also for withdrawals.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_PAYOUT_WALLET_BEP20=
NOWPAYMENTS_PAYOUT_AUTH_TOKEN=

# Optional built-in forge / storage helpers
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
